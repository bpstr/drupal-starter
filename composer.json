{
    "name": "bpstr/drupal-starter",
    "description": "A production-oriented Drupal starter project with a relocated web root.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/community/events/drupal-slack"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/content_entity_sync": "^2.3",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-project-message": "^11.4",
        "drupal/core-recipe-unpack": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/eva": "^3.1",
        "drupal/field_group": "^4.0",
        "drupal/focal_point": "^2.1",
        "drupal/gtm": "^1.10",
        "drupal/mail_login": "^4.2",
        "drupal/metatag": "^2.2",
        "drupal/pathauto": "^1.15",
        "drupal/phpmailer_smtp": "^3.0",
        "drupal/queue_mail": "^1.7",
        "drupal/schema_ui": "^1.2",
        "drupal/simple_sitemap": "^4.2",
        "drupal/toolbar_route": "^1.1",
        "drupal/views_negate": "^2.0",
        "drush/drush": "^13.7"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                     </>",
                "<bg=blue;fg=white>  Drupal starter created. Review README.md to begin.  </>",
                "<bg=blue;fg=white>                                                     </>"
            ]
        }
    }
}
